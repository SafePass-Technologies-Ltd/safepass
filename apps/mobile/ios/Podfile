# Flutter 3.47.9 iOS Podfile template (packages/flutter_tools/templates/
# cocoapods/Podfile-ios at SDK revision c197ca5199), with the platform
# directive enabled. This file must exist before `pod install` can run at all --
# `flutter build ios/ipa` bootstraps CocoaPods on macOS, and `.github/
# workflows/release-ios.yml` calls `pod install` explicitly so a dependency
# resolution failure surfaces as its own red step instead of being buried in the
# build log.
#
# Keeping this file at the stock template (rather than hand-writing CocoaPods
# config) means a future Flutter SDK bump re-applies cleanly and
# `flutter_additional_ios_build_settings` keeps setting the per-pod
# IPHONEOS_DEPLOYMENT_TARGET and Swift/arch flags the engine expects.
#
# Platform is pinned to 13.0 to match IPHONEOS_DEPLOYMENT_TARGET = 13.0 in
# Runner.xcodeproj (the app target, RunnerTests and every configuration). A
# mismatch here is the classic "pods build for 15.0 but the app links at 13.0"
# warning-turned-error on a newer Xcode.
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build
# latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

# Resolves FLUTTER_ROOT from the generated export file rather than an absolute
# path, so the same Podfile works on a dev machine (FVM) and on the macOS CI
# runner (subosito/flutter-action installs to its own SDK cache).
def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

# Defines the shared Flutter pod setup helpers used below.
flutter_ios_podfile_setup

target 'Runner' do
  # All of this app's plugins publish as dynamic frameworks (Firebase, Maps,
  # secure storage, ...), which is what `flutter_ios_podfile_setup` expects.
  use_frameworks!

  # Pulls in every iOS-capable plugin resolved by `flutter pub get`.
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    # Applies Flutter's required build settings per pod (deployment target,
    # bitcode/arch flags, Swift version). Removing this breaks plugin builds
    # once any pod's own podspec targets a different iOS version.
    flutter_additional_ios_build_settings(target)
  end
end
