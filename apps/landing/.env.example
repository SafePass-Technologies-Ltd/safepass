# SafePassLanding (apps/landing) — environment template
# Copy to .env.local for development. Never commit real values.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3004

# --- Lead Intake Service (server-only; never NEXT_PUBLIC_) ---
# The SafePass Backend's lead endpoint. Points at the local Hono API in dev.
LEAD_INTAKE_URL=http://localhost:3000/v1/leads
# Shared service key guarding POST /v1/leads. Must match the API's
# LEAD_INTAKE_API_KEY. Optional in development; REQUIRED in production, where
# the API fails closed (503) without it.
LEAD_INTAKE_API_KEY=
# Abandon the forward call after this many ms and show the visitor the
# Submission Error state with a retry, rather than hanging the form.
LEAD_INTAKE_TIMEOUT_MS=8000

# --- App store links (FEAT-007) ---
# Placeholders until the apps are published.
NEXT_PUBLIC_IOS_APP_URL=https://apps.apple.com/app/safepass
NEXT_PUBLIC_ANDROID_APP_URL=https://play.google.com/store/apps/details?id=com.safepass.app

# --- Rollout gating (user_flow.md Flow 1, Alternate Path B) ---
# When 'false', the App Store CTA is replaced by the waitlist prompt.
NEXT_PUBLIC_APP_LIVE=true

# --- Public support contact (R-004 + FEAT-002) ---
# Shown when automated lead delivery fails (form Submission Error state), and
# as the public support address in the footer and legal pages.
NEXT_PUBLIC_FALLBACK_CONTACT_EMAIL=support@safepass-tech.com
