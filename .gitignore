node_modules/
dist/
.next/
build/
.dart_tool/
.packages
*.log
.env
.env.local
.env.*.local
# apps/mobile: real values for `flutter run/build
# --dart-define-from-file=apps/mobile/.env.json` (see apps/mobile/lib/core/
# constants.dart). .env.example.json is the committed template -- only the
# real .env.json is ignored.
apps/mobile/.env.json
*.tsbuildinfo
coverage/

# apps/mobile: Android upload keystore + its credentials. The Android module's
# own .gitignore already covers app/android/*.jks; these are repo-root
# belt-and-braces so a keystore dropped anywhere (e.g. the repo root while
# copying it to base64 for the ANDROID_KEYSTORE_BASE64 secret) can never be
# committed. The upload key is the signing identity for every Play release --
# losing or leaking it means an upload-certificate reset with Google.
# CI writes these paths transiently during a release and deletes them in an
# `if: always()` cleanup step; they are ignored here so an interrupted run
# cannot leave one staged.
*.jks
*.keystore
apps/mobile/android/upload-keystore.jks

# apps/mobile: release-run intermediates written by .github/workflows/
# release-{android,ios}.yml. Both are generated per run and both leak something
# that must not be committed:
#   * release-defines.json holds the resolved API/WebSocket base URLs and OAuth
#     client ids compiled into a store build (production endpoints, not the
#     committed .env.example.json placeholders);
#   * ios/ExportOptions.plist holds the export method, signing style and Apple
#     team id for the archive.
# Neither is ever a hand-authored file. The workflows delete both in an
# `if: always()` cleanup step, but that is not a substitute for ignoring them: a
# cancelled or killed job never reaches the cleanup, and an untracked file one
# `git add -A` away from a release commit is exactly how endpoint config and
# signing settings leak into a repo.
apps/mobile/release-defines.json
apps/mobile/ios/ExportOptions.plist

# apps/api: local-disk dev-only fallback for emergency audio uploads (used
# when EVIDENCE_BUCKET_NAME/S3 isn't configured -- see emergency.routes.ts's
# AUDIO_UPLOAD_DIR). Production always uses S3 and never writes here, but
# local dev testing can accumulate real recorded audio files that must
# never be committed.
apps/api/uploads/

# Turborepo
.turbo/

# IDE
.idea/
*.iml
.vscode/
.obsidian/

# OS
Thumbs.db
.DS_Store

# Stray local debug/test output
test-output.txt
test-error.txt

# Terraform - local working-dir artifacts generated by `terraform init`/
# `plan`/`apply`. Never commit state (contains resource attributes/secrets
# in plaintext) or the provider plugin cache. terraform-plan.yml's own
# plan_output.txt/tfplan are workflow-run-scoped and regenerated every run.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
# A saved plan is a binary archive of the entire planned change set, with
# resolved variable values baked in -- it must never reach the repo. `tfplan*`
# (not just `tfplan`) is deliberate: a hand-named plan such as `tfplan-hotfix`
# slipped past the old exact-match pattern and was only saved by being
# untracked rather than ignored, so a single `git add -A` would have committed
# it.
tfplan*
plan_output.txt
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Docs should not be pushed because they contain business strategy.
# The whole directory, not `docs/SafePass` -- that pattern matched only the
# core product's folder and silently let `docs/SafePassLanding` through.
docs/
.claude